{
  "name": "@glyphkiln/example-style-showcase",
  "version": "0.0.4",
  "private": true,
  "description": "A deterministic industrial-editorial style showcase for Glyphkiln Core.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  },
  "scripts": {
    "render": "node scripts/render.mjs",
    "verify": "node scripts/render.mjs --verify",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-branches=65 --test-coverage-functions=75 --test-coverage-lines=75 --test-coverage-include=scripts/render.mjs --test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@glyphkiln/core": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "typescript": "7.0.2"
  }
}
