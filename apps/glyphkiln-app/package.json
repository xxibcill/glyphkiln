{
  "name": "@glyphkiln/app",
  "version": "0.0.4",
  "private": true,
  "description": "The self-hostable Glyphkiln application.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node .next/standalone/apps/glyphkiln-app/start.mjs",
    "start:worker": "node .worker/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && npm run test:standalone",
    "test:postgres-qualification": "vitest run src/server/persistence/real-postgres-qualification.test.ts",
    "test:standalone": "npm run build && node scripts/test-standalone.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@glyphkiln/core": "^0.5.0",
    "@node-rs/argon2": "^2.0.2",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
