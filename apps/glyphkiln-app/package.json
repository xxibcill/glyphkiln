{
  "name": "@glyphkiln/app",
  "version": "0.0.7",
  "private": true,
  "description": "The self-hostable Glyphkiln application.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "node .next/standalone/apps/glyphkiln-app/start.mjs",
    "start:worker": "node .worker/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && npm run test:standalone",
    "test:postgres-qualification": "vitest run src/server/persistence/real-postgres-qualification.test.ts",
    "test:standalone": "npm run build && node scripts/test-standalone.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@glyphkiln/core": "^0.8.0",
    "@node-rs/argon2": "^2.2.1",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
