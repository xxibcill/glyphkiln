{
  "name": "@glyphkiln/app",
  "version": "0.0.0",
  "private": true,
  "description": "The self-hostable Glyphkiln application.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "build": "node scripts/build.mjs",
    "start": "node .next/standalone/apps/glyphkiln-app/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && npm run test:standalone",
    "test:standalone": "npm run build && node scripts/test-standalone.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@glyphkiln/core": "^0.2.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
