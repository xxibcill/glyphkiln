# Copy to deploy/self-host/.env, restrict it to the operator account, and do
# not commit the populated file. Use a long URL-safe password because these
# values are interpolated into DATABASE_URL. Use distinct values.
GLYPHKILN_POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-url-safe-migration-secret
GLYPHKILN_POSTGRES_RUNTIME_PASSWORD=replace-with-a-long-url-safe-runtime-secret
GLYPHKILN_POSTGRES_WORKER_PASSWORD=replace-with-a-long-url-safe-worker-secret

# Required only to claim a fresh installation. Generate at least 32 random
# URL-safe characters and keep it available to the intended first owner.
GLYPHKILN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-url-safe-characters

# The browser-visible TLS origin. No path prefix or trailing slash.
GLYPHKILN_PUBLIC_ORIGIN=https://glyphkiln.example.com

# Keep campaign persistence dark until the checked-in campaign-workflow record
# is PASS. The runtime rejects product-qualified while that record is pending.
GLYPHKILN_CAMPAIGN_WORKFLOW=disabled

# Caddy is the only public service. Bind its standard HTTP/HTTPS ports on every
# host address for production, or use 127.0.0.1 for a controlled local drill.
GLYPHKILN_PROXY_BIND_ADDRESS=0.0.0.0
GLYPHKILN_PROXY_HTTP_PORT=80
GLYPHKILN_PROXY_HTTPS_PORT=443

# Leave unset for publicly trusted automatic HTTPS. `tls internal` is only for
# a controlled-access installation or qualification drill with the CA trusted.
# GLYPHKILN_CADDY_TLS=tls internal

# Installation-wide, per-user, per-workspace, and single-app admission defaults.
GLYPHKILN_WORKSPACE_MAX_PER_USER=5
GLYPHKILN_WORKSPACE_MAX_PER_INSTALLATION=100
GLYPHKILN_RENDER_MAX_OUTSTANDING_PER_INSTALLATION=1000
GLYPHKILN_RENDER_MAX_OUTSTANDING_PER_WORKSPACE=100
GLYPHKILN_RESOURCE_MAX_INSTALLATION_ADMISSIONS=100000
GLYPHKILN_RESOURCE_MAX_INSTALLATION_STORED_BYTES=10737418240
GLYPHKILN_RESOURCE_MAX_ADMISSIONS=10000
GLYPHKILN_RESOURCE_MAX_STORED_BYTES=1073741824
GLYPHKILN_RESOURCE_SCAN_GLOBAL_CONCURRENCY=1
GLYPHKILN_RESOURCE_SCAN_WORKSPACE_CONCURRENCY=1
